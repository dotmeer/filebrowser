@using System.Globalization

<article class="task-card @TaskPresentation.StatusCssClass(Task.Status)">
    <header class="task-card-header">
        <div>
            <strong>@TaskPresentation.TypeLabel(Task.Type)</strong>
            <span class="task-status @TaskPresentation.StatusCssClass(Task.Status)">@TaskPresentation.StatusLabel(Task.Status)</span>
        </div>
        <time class="local-time" datetime="@Task.CreatedAtUtc.ToString("O", CultureInfo.InvariantCulture)">@Task.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</time>
    </header>

    <p class="task-route">
        @foreach (var source in Task.Sources)
        {
            <code>@TaskPresentation.FormatReference(source)</code>
        }
        <span aria-hidden="true">→</span>
        <code>@TaskPresentation.FormatReference(Task.Destination)</code>
    </p>

    @if (Task.Status == FileTaskStatus.Queued)
    {
        <p class="task-note">Ожидает запуска.</p>
    }
    else if (Task.Status == FileTaskStatus.Scanning)
    {
        <div class="progress task-progress" role="progressbar" aria-valuetext="Проверка и подсчёт">
            <div class="progress-bar progress-bar-striped progress-bar-animated task-progress-unknown" style="width: 100%">
                Проверка и подсчёт…
            </div>
        </div>
    }
    else if (Task.Status == FileTaskStatus.Running && Percent is null)
    {
        <div class="progress task-progress" role="progressbar" aria-valuetext="Прогресс неизвестен">
            <div class="progress-bar progress-bar-striped progress-bar-animated task-progress-unknown" style="width: 100%">
                Выполняется…
            </div>
        </div>
    }
    else if (Percent is not null)
    {
        <div class="progress task-progress" role="progressbar" aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar @(Task.Status == FileTaskStatus.Failed ? "bg-danger" : string.Empty)" style="@($"width: {Percent}%")">
                @Percent%
            </div>
        </div>
    }

    <div class="task-counters">
        <span>Байты: @TaskPresentation.FormatBytes(Task.BytesDone) / @TaskPresentation.FormatBytes(Task.BytesTotal)</span>
        <span>Объекты: @Task.ItemsDone@(Task.ItemsTotal is null ? string.Empty : $" / {Task.ItemsTotal}")</span>
        @if (BytesPerSecond > 0)
        {
            <span>Скорость: @TaskPresentation.FormatSpeed(BytesPerSecond)</span>
        }
    </div>

    @if (Task.Error is not null)
    {
        <p class="task-error" role="alert">@Task.Error</p>
    }

    @if (Task.Items.Count > 0)
    {
        <details class="task-items" open="@(Task.Status is FileTaskStatus.Failed or FileTaskStatus.Interrupted)">
            <summary>Результат по объектам (@Task.Items.Count)</summary>
            <ul>
                @foreach (var item in Task.Items)
                {
                    <li>
                        <span class="task-item-status @TaskPresentation.ItemStatusCssClass(item.Status)">
                            @TaskPresentation.ItemStatusLabel(item.Status)
                        </span>
                        <code>@TaskPresentation.FormatReference(item.Source)</code>
                        @if (item.ItemsTotal is not null)
                        {
                            <span class="task-item-count">@item.ItemsDone / @item.ItemsTotal</span>
                        }
                        @if (item.Error is not null)
                        {
                            <span class="task-error">@item.Error</span>
                        }
                    </li>
                }
            </ul>
        </details>
    }
</article>

@code {
    [Parameter, EditorRequired] public FileTask Task { get; set; } = null!;

    [Parameter] public double BytesPerSecond { get; set; }

    private int? Percent => TaskPresentation.GetPercent(Task);
}
