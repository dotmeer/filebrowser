@page "/settings"
@rendermode InteractiveServer
@using dotmeer.filebrowser.Settings
@inject IStringLocalizer<SharedResources> L
@inject AppSettingsService AppSettings
@inject NavigationManager Navigation

<PageTitle>@L["Settings_Title"]</PageTitle>

<section class="settings-page">
    <div class="settings-header">
        <button class="settings-close" type="button" aria-label="@L["Settings_Close"]" title="@L["Settings_Close"]" data-nav-back>✕</button>
        <h1>@L["Settings_Title"]</h1>
    </div>

    <section class="settings-section" aria-labelledby="language-heading">
        <h2 id="language-heading">@L["Settings_Language"]</h2>
        <div class="settings-language-form">
            <label class="visually-hidden" for="language-select">@L["Settings_Language"]</label>
            <select id="language-select" class="form-select settings-language" @bind="_language">
                <option value="en">@L["Language_English"]</option>
                <option value="ru">@L["Language_Russian"]</option>
            </select>
            <button class="btn btn-outline-primary" type="button" @onclick="SaveLanguageAsync">@L["Settings_SaveLanguage"]</button>
        </div>
    </section>

    <section class="settings-section" aria-labelledby="theme-heading">
        <h2 id="theme-heading">@L["Settings_Appearance"]</h2>
        <fieldset class="theme-options">
            <legend>@L["Settings_Theme"]</legend>
            <label class="theme-option">
                <input type="radio" name="theme-preference" value="system" />
                <span>@L["Theme_System"]</span>
            </label>
            <label class="theme-option">
                <input type="radio" name="theme-preference" value="light" />
                <span>@L["Theme_Light"]</span>
            </label>
            <label class="theme-option">
                <input type="radio" name="theme-preference" value="dark" />
                <span>@L["Theme_Dark"]</span>
            </label>
        </fieldset>
    </section>

    <section class="settings-section" aria-labelledby="config-heading">
        <h2 id="config-heading">@L["Settings_ServerConfiguration"]</h2>
        <p>@L["Settings_ConfigurationDescription1"] <code>config.yaml</code>.</p>
        <p>@L["Settings_ConfigurationDescription2"]</p>
    </section>
</section>

@code {
    private string _language = "en";

    protected override void OnInitialized()
    {
        _language = AppSettings.GetLanguage();
    }

    private async Task SaveLanguageAsync()
    {
        // Полная перезагрузка страницы: новая культура применяется middleware
        // локализации ко всей странице и будущим Blazor circuit
        // (язык — серверная настройка из SQLite, см. StoredLanguageProvider).
        await AppSettings.SetLanguageAsync(_language, CancellationToken.None);
        Navigation.NavigateTo("/settings", forceLoad: true);
    }
}
