@using dotmeer.filebrowser.FileSystem
@inject FileSystemReadService Reader
@inject IStringLocalizer<SharedResources> L

<li class="tree-node">
    <div class="tree-entry">
        @if (IsRoot || CanExpand)
        {
            <button class="tree-toggle" type="button" aria-label="@(Expanded ? L["Свернуть"] : L["Раскрыть"]) @Name"
                    aria-expanded="@Expanded" disabled="@_loading" @onclick="ToggleAsync">
                @(Expanded ? "▾" : "▸")
            </button>
        }
        else
        {
            <span class="tree-toggle-placeholder"></span>
        }
        <button class="tree-link" type="button" title="@Name" @onclick="NavigateAsync">
            @Name
            @if (!Available)
            {
                <span class="tree-unavailable">@L["(нет доступа)"]</span>
            }
        </button>
    </div>
    @if (Expanded)
    {
        @if (_loading)
        {
            <div class="tree-message">@L["Загрузка…"]</div>
        }
        else if (_error is not null)
        {
            <div class="tree-message tree-error">@_error</div>
            <button class="tree-retry" type="button" @onclick="LoadChildrenAsync">@L["Повторить"]</button>
        }
        else if (HasVisibleChildren)
        {
            <ul>
                @if (ChildRoots is not null)
                {
                    @foreach (var childRoot in ChildRoots)
                    {
                        <DirectoryTreeNode @key="childRoot.Name" Root="@childRoot.Name" Name="@childRoot.Name" Path=""
                                           Available="@childRoot.Available" OnNavigate="@OnNavigate" />
                    }
                }
                else
                {
                    @foreach (var child in _children!)
                    {
                        <DirectoryTreeNode @key="child.Path" Root="@Root" Name="@child.Name" Path="@child.Path"
                                           OnNavigate="@OnNavigate" />
                    }
                }
            </ul>
        }
    }
</li>

@code {
    [Parameter, EditorRequired] public string Root { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string Path { get; set; } = string.Empty;
    [Parameter] public bool IsRoot { get; set; }
    [Parameter] public bool Available { get; set; } = true;
    [Parameter] public EventCallback<FileRef> OnNavigate { get; set; }

    /// <summary>
    /// Синтетические дочерние корни (узел «Все корни», SPEC §9.1): список
    /// настроенных корней из конфигурации, доступный серверу без обхода ФС.
    /// Когда задан, загрузка детей через FileSystemReadService не
    /// выполняется, ленивость сохраняется (дети рендерятся при раскрытии).
    /// </summary>
    [Parameter] public IReadOnlyList<RootDto>? ChildRoots { get; set; }

    private bool Expanded { get; set; }
    private bool _loading;
    private string? _error;
    private IReadOnlyList<FileEntryDto>? _children;
    private bool CanExpand => _children is null || _children.Count > 0;
    private bool HasVisibleChildren => ChildRoots is not null ? ChildRoots.Count > 0 : _children is { Count: > 0 };

    private async Task ToggleAsync()
    {
        if (Expanded)
        {
            Expanded = false;
            return;
        }

        Expanded = true;
        if (ChildRoots is null && _children is null && _error is null)
        {
            await LoadChildrenAsync();
        }
    }

    private async Task LoadChildrenAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var listing = await Task.Run(() => Reader.List(new FileRef(Root, Path)));
            _children = listing.Entries.Where(entry => entry.Kind == "directory").ToArray();
        }
        catch (Exception exception)
        {
            _error = exception switch
            {
                RootUnavailableException => L["Корень временно недоступен."],
                FileSystemObjectNotFoundException => L["Каталог больше не существует."],
                UnsupportedFileSystemObjectException => L["Этот каталог не поддерживается."],
                _ => L["Не удалось загрузить подкаталоги. Проверьте доступ и повторите попытку."]
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private Task NavigateAsync() => OnNavigate.InvokeAsync(new FileRef(Root, Path));
}
