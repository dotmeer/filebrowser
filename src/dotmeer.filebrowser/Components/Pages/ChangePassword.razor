@page "/change-password"
@attribute [Authorize(Policy = AuthPolicies.Authenticated)]
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth_ChangePassword_Title"]</PageTitle>

<section class="auth-page">
    <h1>@L["Auth_ChangePassword_Title"]</h1>
    <p class="auth-description">@L["Auth_ChangePassword_Description"]</p>

    @if (ErrorMessage is not null)
    {
        <p class="dialog-error" role="alert">@ErrorMessage</p>
    }

    <form class="auth-form" method="post" action="/auth/change-password">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="/" />

        <label for="current-password">@L["Auth_CurrentPassword"]</label>
        <input id="current-password" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required autofocus />

        <label for="new-password">@L["Auth_NewPassword"]</label>
        <input id="new-password" name="newPassword" type="password" class="form-control" autocomplete="new-password" required />

        <label for="new-password-confirmation">@L["Auth_PasswordConfirm"]</label>
        <input id="new-password-confirmation" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required />

        <button class="btn btn-primary" type="submit">@L["Auth_SavePassword"]</button>
    </form>

    <form class="auth-form auth-secondary" method="post" action="@AuthEndpoints.LogoutPath">
        <AntiforgeryToken />
        <button class="btn btn-outline-secondary" type="submit">@L["Auth_Logout"]</button>
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "current_password" => L["Auth_Error_CurrentPassword"].Value,
        "same_password" => L["Auth_Error_SamePassword"].Value,
        "password_required" => L["Auth_Error_PasswordRequired"].Value,
        "password_mismatch" => L["Auth_Error_PasswordMismatch"].Value,
        "antiforgery" => L["Auth_Error_Antiforgery"].Value,
        _ => null
    };
}
