@using Microsoft.AspNetCore.WebUtilities
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JavaScript

@if (Definition is not null)
{
    <div class="dialog-backdrop preview-backdrop" @onclick="CloseAsync">
        <section class="preview-dialog" role="dialog" aria-modal="true" aria-label="@L["Предпросмотр: {0}", Entry.Name]"
                 tabindex="-1" @ref="_dialogElement" @onkeydown="HandleKeyDownAsync" @onclick:stopPropagation>
            <header class="preview-header">
                <h2 class="preview-title" title="@Entry.Name">@Entry.Name</h2>
                <div class="preview-actions">
                    <a class="btn btn-outline-secondary" href="@DownloadUrl" download>@L["Скачать"]</a>
                    <button class="preview-close" type="button" @onclick="CloseAsync"
                            aria-label="@L["Закрыть предпросмотр"]" title="@L["Закрыть предпросмотр"]">✕</button>
                </div>
            </header>
            <div class="preview-body">
                @if (Definition.Kind == PreviewKind.Image)
                {
                    <img class="preview-image" src="@PreviewUrl" alt="@Entry.Name" />
                }
                else if (Definition.Kind == PreviewKind.Pdf)
                {
                    <iframe class="preview-frame" src="@PreviewUrl" title="@Entry.Name"></iframe>
                }
                else if (_textFailed)
                {
                    <p class="dialog-error" role="alert">@L["Не удалось загрузить предпросмотр."]</p>
                }
                else
                {
                    @if (_truncated)
                    {
                        <p class="preview-truncated" role="status">@L["Показано только начало файла."]</p>
                    }
                    @if (_textLoading)
                    {
                        <p class="preview-loading" role="status">@L["Загрузка предпросмотра…"]</p>
                    }
                    <div class="preview-text-host" @ref="_textHostElement"></div>
                }
            </div>
        </section>
    </div>
}

@code {
    /// <summary>
    /// Предпросматриваемый файл. Определяет вид предпросмотра через
    /// серверный whitelist расширений (<see cref="PreviewCatalog"/>):
    /// компонент не рендерится для неподдерживаемых типов.
    /// </summary>
    [Parameter, EditorRequired]
    public FileEntryDto Entry { get; set; } = null!;

    /// <summary>Корень текущего листинга (может быть виртуальным AllRoots).</summary>
    [Parameter, EditorRequired]
    public string Root { get; set; } = null!;

    /// <summary>URL скачивания для кнопки «Скачать» (существующий эндпоинт download).</summary>
    [Parameter, EditorRequired]
    public string DownloadUrl { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    private ElementReference _dialogElement;
    private ElementReference _textHostElement;
    private bool _textLoading = true;
    private bool _textFailed;
    private bool _truncated;
    private bool _needsTextLoad = true;
    private bool _disposed;
    private int _requestVersion;
    private string? _loadedKey;

    private PreviewDefinition? Definition => PreviewCatalog.Find(Entry.Name);

    private string PreviewUrl => QueryHelpers.AddQueryString("/api/fs/preview", new Dictionary<string, string?>
    {
        ["root"] = Root,
        ["path"] = Entry.Path
    });

    protected override void OnParametersSet()
    {
        var key = $"{Root}\0{Entry.Path}";
        if (_loadedKey is not null && !string.Equals(_loadedKey, key, StringComparison.Ordinal))
        {
            _requestVersion++;
            _needsTextLoad = true;
            _textLoading = true;
            _textFailed = false;
            _truncated = false;
        }

        _loadedKey = key;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _dialogElement.FocusAsync();
            }
            catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException)
            {
            }
        }

        if (_needsTextLoad)
        {
            _needsTextLoad = false;
            await LoadTextAsync();
        }
    }

    private async Task LoadTextAsync()
    {
        if (Definition?.Kind != PreviewKind.Text)
        {
            _textLoading = false;
            return;
        }

        var requestId = ++_requestVersion;
        try
        {
            // Текст остаётся в DOM; в .NET приходят только метаданные.
            var meta = await JavaScript.InvokeAsync<PreviewTextMeta>(
                "fileBrowser.renderPreviewText",
                _textHostElement,
                PreviewUrl,
                requestId);
            if (_disposed || requestId != _requestVersion)
            {
                return;
            }

            _truncated = meta.Truncated;
            _textFailed = !meta.Ok && !meta.Obsolete;
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            if (!_disposed)
            {
                _textFailed = true;
            }
        }
        finally
        {
            if (!_disposed && requestId == _requestVersion)
            {
                _textLoading = false;
                try
                {
                    StateHasChanged();
                }
                catch (ObjectDisposedException)
                {
                    // Модалку закрыли, пока текст ещё загружался.
                }
            }
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _requestVersion++;
        try
        {
            await JavaScript.InvokeVoidAsync("fileBrowser.clearPreviewText", _textHostElement);
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
            // Модалка уже удалена вместе с circuit.
        }
    }

    private sealed class PreviewTextMeta
    {
        public bool Ok { get; set; }
        public bool Truncated { get; set; }
        public bool Obsolete { get; set; }
    }
}
