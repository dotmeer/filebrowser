@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using dotmeer.filebrowser.FileSystem
@inject FileSystemReadService Reader
@inject FileSystemSearchService SearchService
@inject FileSystemWriteService Writer
@inject TaskDispatcher Dispatcher
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Файлы"]</PageTitle>

<section class="browse-page">
    @if (_taskStatus is not null)
    {
        <p class="task-note" role="status">@_taskStatus</p>
    }

    <div class="browse-layout">
        <aside class="directory-sidebar" aria-label="@L["Дерево каталогов"]">
            <h2>@L["Каталоги"]</h2>
            @if (_roots.Count == 0 && !_rootsLoading)
            {
                <p class="muted">@L["Корни не настроены."]</p>
            }
            else
            {
                <ul class="directory-tree">
                    <DirectoryTreeNode @key="VirtualRoot.VirtualRootName"
                                       Root="@VirtualRoot.VirtualRootName" Name="@L["Все корни"]" Path=""
                                       IsRoot="true" Available="true" ChildRoots="@_roots"
                                       OnNavigate="NavigateToAsync" />
                </ul>
            }
        </aside>
        <PanelSplitter Side="prev" />

        <main class="directory-content">
            <div class="browse-actions" aria-label="@L["Действия с файлами"]">
                <form class="search-form" role="search" @onsubmit="SubmitSearchAsync" @onsubmit:preventDefault>
                    <input class="form-control search-input" type="search" @bind="_searchInput" @bind:event="oninput"
                           placeholder="@L["Поиск в текущей папке"]" aria-label="@L["Поиск в текущей папке"]"
                           disabled="@_searching" />
                    <button class="btn btn-primary" type="submit"
                            disabled="@(_searching || string.IsNullOrWhiteSpace(_searchInput))">
                        @L["Найти"]
                    </button>
                </form>
                @if (!IsSearchActive)
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="RefreshAsync" disabled="@_loading">
                        @L["Обновить"]
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog"
                            disabled="@(_loading || _listing is null || IsVirtualRootView)"
                            title="@VirtualRootReadOnlyHint">
                        @L["Создать папку"]
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="OpenRenameSelected"
                            disabled="@(SelectedEntry is null || _loading || IsVirtualRootView)"
                            title="@VirtualRootReadOnlyHint">
                        @L["Переименовать"]
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="OpenCopySelected"
                            disabled="@(!CanStartTask || _loading || IsVirtualRootView)"
                            title="@VirtualRootReadOnlyHint">
                        @L["Копировать"]
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="OpenMoveSelected"
                            disabled="@(!CanStartTask || _loading || IsVirtualRootView)"
                            title="@VirtualRootReadOnlyHint">
                        @L["Переместить"]
                    </button>
                    @if (SelectedFileDownloadUrl is not null)
                    {
                        <a class="btn btn-outline-secondary" href="@SelectedFileDownloadUrl" download>@L["Скачать"]</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary disabled" aria-disabled="true" tabindex="-1">@L["Скачать"]</a>
                    }
                    <button class="btn btn-outline-danger" type="button" @onclick="OpenDeleteSelected"
                            disabled="@(SelectedEntries.Count == 0 || _loading || IsVirtualRootView)"
                            title="@VirtualRootReadOnlyHint">
                        @L["Удалить"]
                    </button>
                }
            </div>

            @if (IsSearchActive)
            {
                <div class="search-header">
                    <h2 class="search-title">@L["Результаты поиска: «{0}»", SearchQuery!]</h2>
                    <button class="search-close" type="button" @onclick="CloseSearchAsync"
                            aria-label="@L["Закрыть поиск"]" title="@L["Закрыть поиск"]">✕</button>
                </div>
            }
            else if (_listing is not null)
            {
                <nav class="breadcrumbs" aria-label="@L["Путь к каталогу"]">
                    <button type="button" @onclick="() => NavigateToAsync(new FileRef(_listing.Root, string.Empty))">
                        @_listing.Root
                    </button>
                    @foreach (var crumb in GetBreadcrumbs())
                    {
                        <span aria-hidden="true">/</span>
                        <button type="button" @onclick="() => NavigateToAsync(new FileRef(_listing.Root, crumb.Path))">
                            @crumb.Name
                        </button>
                    }
                </nav>
            }

            @if (_loading || _searching)
            {
                <div class="browse-state" role="status">
                    @(_searching ? L["Поиск…"] : L["Загрузка каталога…"])
                    @if (_searching)
                    {
                        <div class="indeterminate-progress" aria-hidden="true"></div>
                    }
                </div>
            }
            else if (_error is not null)
            {
                <div class="browse-state browse-error" role="alert">
                    <strong>@_error</strong>
                    <p>@L["Проверьте адрес или выберите доступный корень дерева."]</p>
                    <button class="btn btn-outline-primary" type="button" @onclick="GoToFirstRootAsync">@L["К корню"]</button>
                </div>
            }
            else if (IsSearchActive)
            {
                @if (_searchResult is { Results.Count: 0 })
                {
                    <div class="browse-state">@L["Ничего не найдено."]</div>
                }
                else if (_searchResult is not null)
                {
                    <div class="table-responsive">
                        <table class="table file-table">
                            <thead>
                                <tr>
                                    <th scope="col" aria-hidden="true"></th>
                                    <th scope="col">@L["Имя"]</th>
                                    <th scope="col">@L["Тип"]</th>
                                    <th scope="col">@L["Размер"]</th>
                                    <th scope="col">@L["Изменён"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _searchResult.Results)
                                {
                                    var parentPath = SearchNavigation.GetParentPath(entry.Path);
                                    // Подзаголовок и tooltip показывают путь от корня:
                                    // для виртуального корня пути результатов уже
                                    // начинаются с имени реального корня (§9.7).
                                    var isVirtualRootSearch = string.Equals(
                                        _searchResult.Root, VirtualRoot.VirtualRootName, StringComparison.Ordinal);
                                    var displayParentPath = isVirtualRootSearch
                                        ? parentPath
                                        : parentPath.Length > 0
                                            ? $"{_searchResult.Root}/{parentPath}"
                                            : _searchResult.Root;
                                    var fullDisplayPath = isVirtualRootSearch
                                        ? entry.Path
                                        : $"{_searchResult.Root}/{entry.Path}";
                                    <tr @key="entry.Path">
                                        <td aria-hidden="true"></td>
                                        <td class="file-name search-file-name" title="@fullDisplayPath">
                                            @if (entry.Kind == "directory")
                                            {
                                                <button class="entry-link" type="button"
                                                        @onclick="() => NavigateToAsync(new FileRef(_searchResult.Root, entry.Path))">
                                                    <span aria-hidden="true">📁</span> @entry.Name
                                                </button>
                                            }
                                            else if (entry.Kind == "unsupported")
                                            {
                                                <span class="unsupported-entry" title="@L["Этот объект нельзя открыть"]">
                                                    <span aria-hidden="true">⚠</span> @entry.Name
                                                </span>
                                            }
                                            else
                                            {
                                                <button class="entry-link" type="button" @onclick="() => OpenSearchResultAsync(entry)">
                                                    <span aria-hidden="true">📄</span> @entry.Name
                                                </button>
                                            }
                                            <span class="search-parent-path" title="@fullDisplayPath">/@displayParentPath</span>
                                        </td>
                                        <td>@GetKindLabel(entry.Kind)</td>
                                        <td>@FormatSize(entry.Size)</td>
                                        <td>@RenderModifiedAt(entry.ModifiedAtUtc)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_searchResult.UnavailableRoots.Count > 0)
                    {
                        <p class="search-unavailable-roots" role="status">
                            @L["Некоторые корни недоступны и не участвовали в поиске: {0}", string.Join(", ", _searchResult.UnavailableRoots)]
                        </p>
                    }
                    @if (_searchResult.Truncated)
                    {
                        <p class="search-truncated" role="status">@L["Результатов больше, чем показано"]</p>
                    }
                }
            }
            else if (_listing is not null && _listing.Entries.Count == 0)
            {
                <div class="browse-state">@L["Папка пуста."]</div>
            }
            else if (_listing is not null)
            {
                <div class="table-responsive">
                    <table class="table file-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">@L["Выбрать"]</span></th>
                                <th scope="col">@L["Имя"]</th>
                                <th scope="col">@L["Тип"]</th>
                                <th scope="col">@L["Размер"]</th>
                                <th scope="col">@L["Изменён"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _listing.Entries)
                            {
                                <tr @key="entry.Path" class="@GetRowHighlightClass(entry)" @oncontextmenu:preventDefault @oncontextmenu="args => OpenContextMenu(entry, args)">
                                    <td>
                                        <input class="form-check-input" type="checkbox" aria-label="@L["Выбрать {0}", entry.Name]"
                                               checked="@_selection.Contains(entry.Path)" disabled="@(entry.Kind == "unsupported")"
                                               @onchange="args => ToggleSelection(entry.Path, args.Value is true)" />
                                    </td>
                                    <td class="file-name" title="@entry.Name">
                                        @if (entry.Kind == "directory")
                                        {
                                            <button class="entry-link" type="button"
                                                    @onclick="() => NavigateToAsync(new FileRef(_listing.Root, entry.Path))">
                                                <span aria-hidden="true">📁</span> @entry.Name
                                            </button>
                                        }
                                        else if (entry.Kind == "unsupported")
                                        {
                                            <span class="unsupported-entry" title="@L["Этот объект нельзя открыть"]">
                                                <span aria-hidden="true">⚠</span> @entry.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span @ondblclick="() => OpenPreviewIfSupported(entry)"><span aria-hidden="true">📄</span> @entry.Name</span>
                                        }
                                    </td>
                                    <td>@GetKindLabel(entry.Kind)</td>
                                    <td>@FormatSize(entry.Size)</td>
                                    <td>@RenderModifiedAt(entry.ModifiedAtUtc)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
        <PanelSplitter Side="next" />

        <TaskPanel OnTaskCompleted="HandleTaskCompletedAsync" />
    </div>

    @if (_contextEntry is not null)
    {
        <div class="file-context-menu" role="menu" style="@($"left: {_contextX}px; top: {_contextY}px;")">
            @if (_contextEntry.Kind == "file")
            {
                @if (PreviewCatalog.Find(_contextEntry.Name) is not null)
                {
                    <button type="button" role="menuitem" @onclick="() => OpenPreview(_contextEntry!)">@L["Предпросмотр"]</button>
                }
                <a class="context-menu-link" href="@GetDownloadUrl(_contextEntry)" download role="menuitem">@L["Скачать"]</a>
            }
            <button type="button" role="menuitem" @onclick="() => OpenRename(_contextEntry!)">@L["Переименовать"]</button>
            <button type="button" role="menuitem" @onclick="() => OpenCopy(_contextEntry!)">@L["Копировать"]</button>
            <button type="button" role="menuitem" @onclick="() => OpenMove(_contextEntry!)">@L["Переместить"]</button>
            <button type="button" role="menuitem" @onclick="() => OpenDelete(_contextEntry!)">@L["Удалить"]</button>
        </div>
    }

    @if (_dialog is not null)
    {
        <div class="dialog-backdrop">
            <section class="file-dialog" role="dialog" aria-modal="true" aria-labelledby="file-dialog-title">
                @if (_dialog == DialogKind.Create)
                {
                    <h2 id="file-dialog-title">@L["Создать папку"]</h2>
                    <label for="new-folder-name">@L["Имя новой папки"]</label>
                    <input id="new-folder-name" class="form-control" @bind="_newFolderName" disabled="@_operationInProgress" />
                    <p class="dialog-hint">@L["Имя не может содержать путь или начинаться с"] <code>.filebrowser-</code>.</p>
                }
                else if (_dialog == DialogKind.Rename && _dialogTarget is not null)
                {
                    <h2 id="file-dialog-title">@L["Переименовать «{0}»", _dialogTarget.Name]</h2>
                    <label for="new-name">@L["Новое имя"]</label>
                    <input id="new-name" class="form-control" @bind="_newName" disabled="@_operationInProgress" />
                    <p class="dialog-hint">@L["Объект с таким именем не будет перезаписан."]</p>
                }
                else if (_dialog == DialogKind.Delete && _deleteTargets.Count > 0)
                {
                    @if (_dialogTarget is not null)
                    {
                        <h2 id="file-dialog-title">@L["Удалить «{0}»?", _dialogTarget.Name]</h2>
                    }
                    else
                    {
                        <h2 id="file-dialog-title">@L["Удалить выбранные объекты ({0})?", _deleteTargets.Count]</h2>
                        <ul class="dialog-list">
                            @foreach (var target in _deleteTargets.Take(5))
                            {
                                <li><code>@target.Name</code></li>
                            }
                            @if (_deleteTargets.Count > 5)
                            {
                                <li>@L["и ещё {0}", _deleteTargets.Count - 5]</li>
                            }
                        </ul>
                    }
                    <p class="dialog-warning">@L["Удаление безвозвратное. Каталог будет удалён вместе со всем содержимым."]</p>
                    <div class="form-check">
                        <input id="confirm-delete" class="form-check-input" type="checkbox" @bind="_deleteConfirmed" disabled="@_operationInProgress" />
                        <label class="form-check-label" for="confirm-delete">@L["Я понимаю, что объект нельзя будет восстановить"]</label>
                    </div>
                }

                @if (_operationError is not null)
                {
                    <p class="dialog-error" role="alert">@_operationError</p>
                }

                <div class="dialog-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseDialog" disabled="@_operationInProgress">@L["Отмена"]</button>
                    @if (_dialog == DialogKind.Create)
                    {
                        <button class="btn btn-primary" type="button" @onclick="CreateDirectoryAsync" disabled="@_operationInProgress">@L["Создать"]</button>
                    }
                    else if (_dialog == DialogKind.Rename)
                    {
                        <button class="btn btn-primary" type="button" @onclick="RenameAsync" disabled="@_operationInProgress">@L["Переименовать"]</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" type="button" @onclick="DeleteAsync" disabled="@(!_deleteConfirmed || _operationInProgress)">@L["Удалить"]</button>
                    }
                </div>
            </section>
        </div>
    }

    @if (_taskType is not null && _listing is not null)
    {
        <DestinationPicker Roots="@_roots" TaskType="@_taskType.Value"
                           Current="@(new FileRef(_listing.Root, _listing.Path))"
                           Sources="@_taskSources" Busy="@_taskBusy" Error="@_taskError"
                           OnConfirm="EnqueueTaskAsync" OnCancel="CloseTaskDialog" />
    }

    @if (_previewEntry is not null && _listing is not null)
    {
        <PreviewModal Entry="@_previewEntry" Root="@_listing.Root"
                      DownloadUrl="@GetDownloadUrl(_previewEntry)" OnClose="ClosePreviewAsync" />
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "root")]
    public string? RootQuery { get; set; }

    [SupplyParameterFromQuery(Name = "path")]
    public string? PathQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "highlight")]
    public string? HighlightQuery { get; set; }

    private IReadOnlyList<RootDto> _roots = [];
    private DirectoryListingDto? _listing;
    private SearchResultDto? _searchResult;
    private string _searchInput = string.Empty;
    private bool _searching;
    private readonly HashSet<string> _selection = new(StringComparer.Ordinal);
    private string? _error;
    private bool _loading;
    private bool _rootsLoading;
    private int _requestVersion;
    private FileEntryDto? _contextEntry;
    private FileEntryDto? _dialogTarget;
    private IReadOnlyList<FileEntryDto> _deleteTargets = [];
    private DialogKind? _dialog;
    private string _newFolderName = string.Empty;
    private string _newName = string.Empty;
    private string? _operationError;
    private bool _deleteConfirmed;
    private bool _operationInProgress;
    private double _contextX;
    private double _contextY;
    private FileTaskType? _taskType;
    private FileEntryDto? _previewEntry;
    private IReadOnlyList<FileRef> _taskSources = [];
    private bool _taskBusy;
    private string? _taskError;
    private string? _taskStatus;

    private IReadOnlyList<FileEntryDto> SelectedEntries =>
        _listing is null
            ? []
            : _listing.Entries.Where(entry => _selection.Contains(entry.Path)).ToArray();

    private FileEntryDto? SelectedEntry =>
        SelectedEntries is [var entry] ? entry : null;

    private bool CanStartTask => SelectedEntries.Count > 0;

    private bool IsSearchActive => !string.IsNullOrWhiteSpace(SearchQuery);

    /// <summary>
    /// Текущая панель показывает виртуальный корень (SPEC §9.1): изменяющие
    /// действия заблокированы, чтение, скачивание и поиск доступны.
    /// </summary>
    private bool IsVirtualRootView => VirtualRoot.IsVirtualRoot(_listing?.Root ?? RootQuery);

    /// <summary>
    /// Локализованная подсказка для заблокированных кнопок внутри виртуального
    /// корня (SPEC §9.1); null вне виртуального корня — title не рендерится.
    /// </summary>
    private string? VirtualRootReadOnlyHint =>
        IsVirtualRootView ? (string?)L["В виртуальном корне доступно только чтение"] : null;

    private string? SelectedFileDownloadUrl =>
        SelectedEntry is { Kind: "file" } entry ? GetDownloadUrl(entry) : null;

    private string GetDownloadUrl(FileEntryDto entry)
    {
        var query = new Dictionary<string, string?>
        {
            ["root"] = _listing!.Root,
            ["path"] = entry.Path
        };
        return QueryHelpers.AddQueryString("/api/fs/download", query);
    }

    /// <summary>
    /// Открывает предпросмотр (модально), если тип файла входит в серверный
    /// whitelist расширений (SPEC §16); иначе no-op.
    /// </summary>
    private Task OpenPreviewIfSupported(FileEntryDto entry) =>
        entry.Kind == "file" && PreviewCatalog.Find(entry.Name) is not null
            ? OpenPreview(entry)
            : Task.CompletedTask;

    private Task OpenPreview(FileEntryDto entry)
    {
        _contextEntry = null;
        _previewEntry = entry;
        return Task.CompletedTask;
    }

    private Task ClosePreviewAsync()
    {
        _previewEntry = null;
        return Task.CompletedTask;
    }

    protected override Task OnParametersSetAsync() => LoadCurrentAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JavaScript.InvokeVoidAsync("fileBrowser.formatLocalTimes");
            if (!string.IsNullOrEmpty(HighlightQuery))
            {
                await JavaScript.InvokeVoidAsync("fileBrowser.scrollToHighlighted");
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException)
        {
            // During static prerendering JavaScript is not available yet.
        }
    }

    private async Task LoadCurrentAsync()
    {
        var requestVersion = ++_requestVersion;
        _loading = true;
        _rootsLoading = true;
        _error = null;
        _selection.Clear();
        _previewEntry = null;

        try
        {
            _roots = await Task.Run(Reader.GetRoots);
            if (requestVersion != _requestVersion)
            {
                return;
            }
            _rootsLoading = false;

            var root = RootQuery ?? _roots.FirstOrDefault()?.Name;
            if (string.IsNullOrWhiteSpace(root))
            {
                _error = L["Не настроен ни один корень файловой системы."];
                _listing = null;
                _searchResult = null;
                return;
            }

            if (IsSearchActive)
            {
                _listing = null;
                _searchInput = SearchQuery!;
                _searchResult = null;
                _searching = true;
                if (RendererInfo.IsInteractive)
                {
                    // Показать «Поиск…» до завершения синхронного обхода.
                    await InvokeAsync(StateHasChanged);
                }

                _searchResult = SearchService.Search(
                    new FileRef(root, PathQuery ?? string.Empty),
                    SearchQuery!,
                    ext: null,
                    extGlobs: null,
                    limit: FileSystemSearchService.DefaultResultLimit,
                    cancellationToken: CancellationToken.None);
            }
            else
            {
                _searchResult = null;
                _listing = await Task.Run(() => Reader.List(new FileRef(root, PathQuery ?? string.Empty)));
            }
        }
        catch (Exception exception)
        {
            if (requestVersion == _requestVersion)
            {
                _listing = null;
                _searchResult = null;
                _error = GetSafeError(exception);
            }
        }
        finally
        {
            if (requestVersion == _requestVersion)
            {
                _rootsLoading = false;
                _loading = false;
                _searching = false;
            }
        }
    }

    private Task RefreshAsync() => LoadCurrentAsync();

    private Task SubmitSearchAsync()
    {
        var query = _searchInput.Trim();
        if (_searching || query.Length == 0)
        {
            return Task.CompletedTask;
        }

        var location = CurrentLocation;
        Navigation.NavigateTo(SearchNavigation.BuildSearchUrl(location.Root, location.Path, query));
        return Task.CompletedTask;
    }

    private Task CloseSearchAsync()
    {
        var location = CurrentLocation;
        Navigation.NavigateTo(SearchNavigation.BuildBrowseUrl(location.Root, location.Path));
        return Task.CompletedTask;
    }

    private Task OpenSearchResultAsync(FileEntryDto entry)
    {
        if (_searchResult is null)
        {
            return Task.CompletedTask;
        }

        Navigation.NavigateTo(SearchNavigation.BuildBrowseUrl(
            _searchResult.Root,
            SearchNavigation.GetParentPath(entry.Path),
            entry.Name));
        return Task.CompletedTask;
    }

    private FileRef CurrentLocation =>
        IsSearchActive && _searchResult is not null
            ? new FileRef(_searchResult.Root, _searchResult.Path)
            : _listing is not null
                ? new FileRef(_listing.Root, _listing.Path)
                : new FileRef(RootQuery ?? string.Empty, PathQuery ?? string.Empty);

    private string? GetRowHighlightClass(FileEntryDto entry) =>
        !IsSearchActive && !string.IsNullOrEmpty(HighlightQuery)
            && string.Equals(entry.Name, HighlightQuery, StringComparison.Ordinal)
                ? "row-highlighted"
                : null;

    private void OpenContextMenu(FileEntryDto entry, MouseEventArgs args)
    {
        if (IsSearchActive || IsVirtualRootView || entry.Kind == "unsupported")
        {
            return;
        }

        _contextEntry = entry;
        _contextX = args.ClientX;
        _contextY = args.ClientY;
    }

    private void OpenCreateDialog()
    {
        _contextEntry = null;
        _dialog = DialogKind.Create;
        _newFolderName = string.Empty;
        _operationError = null;
    }

    private void OpenRenameSelected()
    {
        if (SelectedEntry is not null)
        {
            OpenRename(SelectedEntry);
        }
    }

    private void OpenRename(FileEntryDto entry)
    {
        _contextEntry = null;
        _dialog = DialogKind.Rename;
        _dialogTarget = entry;
        _newName = entry.Name;
        _operationError = null;
    }

    private void OpenDeleteSelected()
    {
        var entries = SelectedEntries;
        if (entries.Count == 0)
        {
            return;
        }

        _contextEntry = null;
        _dialog = DialogKind.Delete;
        _deleteTargets = entries;
        _dialogTarget = entries.Count == 1 ? entries[0] : null;
        _deleteConfirmed = false;
        _operationError = null;
    }

    private void OpenDelete(FileEntryDto entry)
    {
        _contextEntry = null;
        _dialog = DialogKind.Delete;
        _deleteTargets = [entry];
        _dialogTarget = entry;
        _deleteConfirmed = false;
        _operationError = null;
    }

    private void CloseDialog()
    {
        if (_operationInProgress)
        {
            return;
        }

        _dialog = null;
        _dialogTarget = null;
        _deleteTargets = [];
        _operationError = null;
    }

    private void OpenCopySelected() => OpenTaskDialog(FileTaskType.Copy, SelectedEntries);

    private void OpenMoveSelected() => OpenTaskDialog(FileTaskType.Move, SelectedEntries);

    private void OpenCopy(FileEntryDto entry) => OpenTaskDialog(FileTaskType.Copy, [entry]);

    private void OpenMove(FileEntryDto entry) => OpenTaskDialog(FileTaskType.Move, [entry]);

    private void OpenTaskDialog(FileTaskType type, IReadOnlyList<FileEntryDto> entries)
    {
        if (_listing is null || entries.Count == 0)
        {
            return;
        }

        _contextEntry = null;
        _taskType = type;
        _taskSources = entries.Select(entry => new FileRef(_listing.Root, entry.Path)).ToArray();
        _taskError = null;
        _taskBusy = false;
        _taskStatus = null;
    }

    private void CloseTaskDialog()
    {
        if (_taskBusy)
        {
            return;
        }

        _taskType = null;
        _taskSources = [];
        _taskError = null;
    }

    private async Task EnqueueTaskAsync(FileRef destination)
    {
        if (_taskType is null || _taskSources.Count == 0)
        {
            return;
        }

        var type = _taskType.Value;
        var sources = _taskSources;
        _taskBusy = true;
        _taskError = null;
        try
        {
            await Task.Run(async () => await Dispatcher.EnqueueAsync(type, sources, destination));
            _taskStatus = L["Задача поставлена в очередь."];
            _taskType = null;
            _taskSources = [];
        }
        catch (Exception exception)
        {
            _taskError = GetSafeTaskError(exception);
        }
        finally
        {
            _taskBusy = false;
        }
    }

    private Task HandleTaskCompletedAsync(FileTask task)
    {
        _ = task;
        return LoadCurrentAsync();
    }

    private async Task CreateDirectoryAsync()
    {
        if (_listing is null)
        {
            return;
        }

        await ExecuteMutationAsync(() => Writer.CreateDirectory(new FileRef(_listing.Root, _listing.Path), _newFolderName));
    }

    private async Task RenameAsync()
    {
        if (_listing is null || _dialogTarget is null)
        {
            return;
        }

        var source = new FileRef(_listing.Root, _dialogTarget.Path);
        await ExecuteMutationAsync(() => Writer.Rename(source, _newName));
    }

    private async Task DeleteAsync()
    {
        if (_listing is null || _deleteTargets.Count == 0 || !_deleteConfirmed)
        {
            return;
        }

        // Удаление (один объект или несколько) выполняется фоновой задачей
        // (SPEC §13.9): предпроверка, частичный результат и отмена доступны
        // независимо от состояния circuit. Все выбранные объекты — дети
        // текущей папки, поэтому она же передаётся как исходная папка задачи.
        var sources = _deleteTargets.Select(entry => new FileRef(_listing.Root, entry.Path)).ToArray();
        var sourceFolder = new FileRef(_listing.Root, _listing.Path);
        _operationInProgress = true;
        _operationError = null;
        try
        {
            await Task.Run(async () => await Dispatcher.EnqueueAsync(FileTaskType.Delete, sources, sourceFolder));
            _operationInProgress = false;
            _selection.Clear();
            CloseDialog();
        }
        catch (Exception exception)
        {
            _operationError = GetSafeTaskError(exception);
        }
        finally
        {
            _operationInProgress = false;
        }
    }

    private async Task ExecuteMutationAsync(Action mutation)
    {
        _operationInProgress = true;
        _operationError = null;
        try
        {
            await Task.Run(mutation);
            await LoadCurrentAsync();
            _operationInProgress = false;
            CloseDialog();
        }
        catch (Exception exception)
        {
            _operationError = GetSafeMutationError(exception);
        }
        finally
        {
            _operationInProgress = false;
        }
    }

    private Task NavigateToAsync(FileRef fileRef)
    {
        var query = new Dictionary<string, string?>
        {
            ["root"] = fileRef.Root,
            ["path"] = fileRef.Path
        };
        Navigation.NavigateTo(QueryHelpers.AddQueryString("/", query));
        return Task.CompletedTask;
    }

    private Task GoToFirstRootAsync()
    {
        var root = _roots.FirstOrDefault()?.Name;
        return root is null ? Task.CompletedTask : NavigateToAsync(new FileRef(root, string.Empty));
    }

    private IReadOnlyList<Breadcrumb> GetBreadcrumbs()
    {
        if (_listing is null || string.IsNullOrEmpty(_listing.Path))
        {
            return [];
        }

        var segments = _listing.Path.Split('/');
        var crumbs = new List<Breadcrumb>(segments.Length);
        var path = string.Empty;
        foreach (var segment in segments)
        {
            path = path.Length == 0 ? segment : $"{path}/{segment}";
            crumbs.Add(new Breadcrumb(segment, path));
        }
        return crumbs;
    }

    private void ToggleSelection(string path, bool selected)
    {
        if (selected)
        {
            _selection.Add(path);
        }
        else
        {
            _selection.Remove(path);
        }
    }

    private string GetKindLabel(string kind) => kind switch
    {
        "directory" => L["Папка"],
        "file" => L["Файл"],
        _ => L["Не поддерживается"]
    };

    private static RenderFragment RenderModifiedAt(DateTimeOffset? modifiedAtUtc) => builder =>
    {
        if (modifiedAtUtc is not { } value)
        {
            builder.AddContent(0, "—");
            return;
        }

        builder.OpenElement(0, "time");
        builder.AddAttribute(1, "class", "local-time");
        builder.AddAttribute(2, "datetime", value.ToString("O", CultureInfo.InvariantCulture));
        builder.AddContent(3, $"{value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC");
        builder.CloseElement();
    };

    private string FormatSize(long? size)
    {
        if (size is null)
        {
            return "—";
        }
        if (size < 1024)
        {
            return string.Create(CultureInfo.InvariantCulture, $"{size.Value} {L["Б"]}");
        }
        var units = new[] { "КБ", "МБ", "ГБ", "ТБ" };
        var value = (double)size.Value;
        var unit = -1;
        do
        {
            value /= 1024;
            unit++;
        } while (value >= 1024 && unit < units.Length - 1);
        return string.Create(CultureInfo.InvariantCulture, $"{value:0.#} {L[units[unit]]}");
    }

    private string GetSafeError(Exception exception) => exception switch
    {
        RootUnavailableException => L["Корень временно недоступен."],
        FileSystemObjectNotFoundException => L["Корень или каталог не найден. Возможно, объект был перемещён или удалён."],
        UnsupportedFileSystemObjectException => L["Этот объект файловой системы не поддерживается."],
        InvalidFileSystemRequestException => L["Некорректный адрес каталога."],
        FileSystemResolutionException => L["Не удалось открыть каталог."],
        _ => L["Не удалось загрузить каталог. Проверьте доступ и повторите попытку."]
    };

    private string GetSafeMutationError(Exception exception) => exception switch
    {
        FileSystemNameConflictException => L["Объект с таким именем уже существует."],
        FileSystemObjectNotFoundException => L["Объект больше не существует. Обновите каталог."],
        RootUnavailableException => L["Корень временно недоступен."],
        FileSystemAccessDeniedException => L["Недостаточно прав для выполнения операции."],
        UnsupportedFileSystemObjectException => L["Этот объект не поддерживается."],
        InvalidFileSystemRequestException => L["Проверьте имя и выбранный объект."],
        _ => L["Не удалось выполнить операцию. Повторите попытку."]
    };

    private string GetSafeTaskError(Exception exception) => exception switch
    {
        FileTaskQueueFullException => L["Очередь задач заполнена. Дождитесь завершения текущих задач."],
        InvalidFileSystemRequestException => L["Проверьте выбранные объекты и папку назначения."],
        FileSystemResolutionException => L["Не удалось открыть выбранный объект или папку назначения."],
        ArgumentException => L["Проверьте выбранные объекты и папку назначения."],
        _ => L["Не удалось поставить задачу. Повторите попытку."]
    };

    private sealed record Breadcrumb(string Name, string Path);

    private enum DialogKind
    {
        Create,
        Rename,
        Delete
    }
}
