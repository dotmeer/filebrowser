@page "/browse"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using dotmeer.filebrowser.FileSystem
@inject FileSystemReadService Reader
@inject FileSystemWriteService Writer
@inject TaskDispatcher Dispatcher
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Файлы</PageTitle>

<section class="browse-page">
    <header class="browse-header">
        <div>
            <h1>Файлы</h1>
            @if (_listing is not null)
            {
                <p class="browse-selection">Выбрано: @_selection.Count</p>
            }
        </div>
        <div class="browse-actions" aria-label="Действия с файлами">
            <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog" disabled="@(_loading || _listing is null)">
                Создать папку
            </button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenRenameSelected" disabled="@(SelectedEntry is null || _loading)">
                Переименовать
            </button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenCopySelected" disabled="@(!CanStartTask || _loading)">
                Копировать
            </button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenMoveSelected" disabled="@(!CanStartTask || _loading)">
                Переместить
            </button>
            @if (SelectedFileDownloadUrl is not null)
            {
                <a class="btn btn-outline-secondary" href="@SelectedFileDownloadUrl" download>Скачать</a>
            }
            else
            {
                <a class="btn btn-outline-secondary disabled" aria-disabled="true" tabindex="-1">Скачать</a>
            }
            <button class="btn btn-outline-danger" type="button" @onclick="OpenDeleteSelected" disabled="@(SelectedEntry is null || _loading)">
                Удалить
            </button>
            <button class="btn btn-outline-secondary" type="button" @onclick="RefreshAsync" disabled="@_loading">
                Обновить
            </button>
        </div>
    </header>

    @if (_taskStatus is not null)
    {
        <p class="task-note" role="status">@_taskStatus</p>
    }

    <div class="browse-layout">
        <aside class="directory-sidebar" aria-label="Дерево каталогов">
            <h2>Каталоги</h2>
            @if (_roots.Count == 0 && !_rootsLoading)
            {
                <p class="muted">Корни не настроены.</p>
            }
            else
            {
                <ul class="directory-tree">
                    @foreach (var root in _roots)
                    {
                        <DirectoryTreeNode @key="root.Name" Root="@root.Name" Name="@root.Name" Path="" IsRoot="true"
                                           Available="@root.Available" OnNavigate="NavigateToAsync" />
                    }
                </ul>
            }
        </aside>

        <main class="directory-content">
            @if (_listing is not null)
            {
                <nav class="breadcrumbs" aria-label="Путь к каталогу">
                    <button type="button" @onclick="() => NavigateToAsync(new FileRef(_listing.Root, string.Empty))">
                        @_listing.Root
                    </button>
                    @foreach (var crumb in GetBreadcrumbs())
                    {
                        <span aria-hidden="true">/</span>
                        <button type="button" @onclick="() => NavigateToAsync(new FileRef(_listing.Root, crumb.Path))">
                            @crumb.Name
                        </button>
                    }
                </nav>
            }

            @if (_loading)
            {
                <div class="browse-state" role="status">Загрузка каталога…</div>
            }
            else if (_error is not null)
            {
                <div class="browse-state browse-error" role="alert">
                    <strong>@_error</strong>
                    <p>Проверьте адрес или выберите доступный корень дерева.</p>
                    <button class="btn btn-outline-primary" type="button" @onclick="GoToFirstRootAsync">К корню</button>
                </div>
            }
            else if (_listing is not null && _listing.Entries.Count == 0)
            {
                <div class="browse-state">Папка пуста.</div>
            }
            else if (_listing is not null)
            {
                <div class="table-responsive">
                    <table class="table file-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">Выбрать</span></th>
                                <th scope="col">Имя</th>
                                <th scope="col">Тип</th>
                                <th scope="col">Размер</th>
                                <th scope="col">Изменён</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _listing.Entries)
                            {
                                <tr @key="entry.Path" @oncontextmenu:preventDefault @oncontextmenu="args => OpenContextMenu(entry, args)">
                                    <td>
                                        <input class="form-check-input" type="checkbox" aria-label="Выбрать @entry.Name"
                                               checked="@_selection.Contains(entry.Path)" disabled="@(entry.Kind == "unsupported")"
                                               @onchange="args => ToggleSelection(entry.Path, args.Value is true)" />
                                    </td>
                                    <td class="file-name" title="@entry.Name">
                                        @if (entry.Kind == "directory")
                                        {
                                            <button class="entry-link" type="button"
                                                    @onclick="() => NavigateToAsync(new FileRef(_listing.Root, entry.Path))">
                                                <span aria-hidden="true">📁</span> @entry.Name
                                            </button>
                                        }
                                        else if (entry.Kind == "unsupported")
                                        {
                                            <span class="unsupported-entry" title="Этот объект нельзя открыть">
                                                <span aria-hidden="true">⚠</span> @entry.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span><span aria-hidden="true">📄</span> @entry.Name</span>
                                        }
                                    </td>
                                    <td>@GetKindLabel(entry.Kind)</td>
                                    <td>@FormatSize(entry.Size)</td>
                                    <td><time class="local-time" datetime="@entry.ModifiedAtUtc.ToString("O", CultureInfo.InvariantCulture)">@entry.ModifiedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</time></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
    </div>

    @if (_contextEntry is not null)
    {
        <div class="file-context-menu" role="menu" style="@($"left: {_contextX}px; top: {_contextY}px;")">
            @if (_contextEntry.Kind == "file")
            {
                <a class="context-menu-link" href="@GetDownloadUrl(_contextEntry)" download role="menuitem">Скачать</a>
            }
            <button type="button" role="menuitem" @onclick="() => OpenRename(_contextEntry!)">Переименовать</button>
            <button type="button" role="menuitem" @onclick="() => OpenCopy(_contextEntry!)">Копировать</button>
            <button type="button" role="menuitem" @onclick="() => OpenMove(_contextEntry!)">Переместить</button>
            <button type="button" role="menuitem" @onclick="() => OpenDelete(_contextEntry!)">Удалить</button>
        </div>
    }

    @if (_dialog is not null)
    {
        <div class="dialog-backdrop">
            <section class="file-dialog" role="dialog" aria-modal="true" aria-labelledby="file-dialog-title">
                @if (_dialog == DialogKind.Create)
                {
                    <h2 id="file-dialog-title">Создать папку</h2>
                    <label for="new-folder-name">Имя новой папки</label>
                    <input id="new-folder-name" class="form-control" @bind="_newFolderName" disabled="@_operationInProgress" />
                    <p class="dialog-hint">Имя не может содержать путь или начинаться с <code>.filebrowser-</code>.</p>
                }
                else if (_dialog == DialogKind.Rename && _dialogTarget is not null)
                {
                    <h2 id="file-dialog-title">Переименовать «@_dialogTarget.Name»</h2>
                    <label for="new-name">Новое имя</label>
                    <input id="new-name" class="form-control" @bind="_newName" disabled="@_operationInProgress" />
                    <p class="dialog-hint">Объект с таким именем не будет перезаписан.</p>
                }
                else if (_dialog == DialogKind.Delete && _dialogTarget is not null)
                {
                    <h2 id="file-dialog-title">Удалить «@_dialogTarget.Name»?</h2>
                    <p class="dialog-warning">Удаление безвозвратное. Каталог будет удалён вместе со всем содержимым.</p>
                    <div class="form-check">
                        <input id="confirm-delete" class="form-check-input" type="checkbox" @bind="_deleteConfirmed" disabled="@_operationInProgress" />
                        <label class="form-check-label" for="confirm-delete">Я понимаю, что объект нельзя будет восстановить</label>
                    </div>
                }

                @if (_operationError is not null)
                {
                    <p class="dialog-error" role="alert">@_operationError</p>
                }

                <div class="dialog-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseDialog" disabled="@_operationInProgress">Отмена</button>
                    @if (_dialog == DialogKind.Create)
                    {
                        <button class="btn btn-primary" type="button" @onclick="CreateDirectoryAsync" disabled="@_operationInProgress">Создать</button>
                    }
                    else if (_dialog == DialogKind.Rename)
                    {
                        <button class="btn btn-primary" type="button" @onclick="RenameAsync" disabled="@_operationInProgress">Переименовать</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" type="button" @onclick="DeleteAsync" disabled="@(!_deleteConfirmed || _operationInProgress)">Удалить</button>
                    }
                </div>
            </section>
        </div>
    }

    @if (_taskType is not null && _listing is not null)
    {
        <DestinationPicker Roots="@_roots" TaskType="@_taskType.Value"
                           Current="@(new FileRef(_listing.Root, _listing.Path))"
                           Sources="@_taskSources" Busy="@_taskBusy" Error="@_taskError"
                           OnConfirm="EnqueueTaskAsync" OnCancel="CloseTaskDialog" />
    }

    <TaskPanel OnTaskCompleted="HandleTaskCompletedAsync" />
</section>

@code {
    [SupplyParameterFromQuery(Name = "root")]
    public string? RootQuery { get; set; }

    [SupplyParameterFromQuery(Name = "path")]
    public string? PathQuery { get; set; }

    private IReadOnlyList<RootDto> _roots = [];
    private DirectoryListingDto? _listing;
    private readonly HashSet<string> _selection = new(StringComparer.Ordinal);
    private string? _error;
    private bool _loading;
    private bool _rootsLoading;
    private int _requestVersion;
    private FileEntryDto? _contextEntry;
    private FileEntryDto? _dialogTarget;
    private DialogKind? _dialog;
    private string _newFolderName = string.Empty;
    private string _newName = string.Empty;
    private string? _operationError;
    private bool _deleteConfirmed;
    private bool _operationInProgress;
    private double _contextX;
    private double _contextY;
    private FileTaskType? _taskType;
    private IReadOnlyList<FileRef> _taskSources = [];
    private bool _taskBusy;
    private string? _taskError;
    private string? _taskStatus;

    private IReadOnlyList<FileEntryDto> SelectedEntries =>
        _listing is null
            ? []
            : _listing.Entries.Where(entry => _selection.Contains(entry.Path)).ToArray();

    private FileEntryDto? SelectedEntry =>
        SelectedEntries is [var entry] ? entry : null;

    private bool CanStartTask => SelectedEntries.Count > 0;

    private string? SelectedFileDownloadUrl =>
        SelectedEntry is { Kind: "file" } entry ? GetDownloadUrl(entry) : null;

    private string GetDownloadUrl(FileEntryDto entry)
    {
        var query = new Dictionary<string, string?>
        {
            ["root"] = _listing!.Root,
            ["path"] = entry.Path
        };
        return QueryHelpers.AddQueryString("/api/fs/download", query);
    }

    protected override Task OnParametersSetAsync() => LoadCurrentAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JavaScript.InvokeVoidAsync("fileBrowser.formatLocalTimes");
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException)
        {
            // During static prerendering JavaScript is not available yet.
        }
    }

    private async Task LoadCurrentAsync()
    {
        var requestVersion = ++_requestVersion;
        _loading = true;
        _rootsLoading = true;
        _error = null;
        _selection.Clear();

        try
        {
            _roots = await Task.Run(Reader.GetRoots);
            if (requestVersion != _requestVersion)
            {
                return;
            }
            _rootsLoading = false;

            var root = RootQuery ?? _roots.FirstOrDefault()?.Name;
            if (string.IsNullOrWhiteSpace(root))
            {
                _error = "Не настроен ни один корень файловой системы.";
                _listing = null;
                return;
            }

            _listing = await Task.Run(() => Reader.List(new FileRef(root, PathQuery ?? string.Empty)));
        }
        catch (Exception exception)
        {
            if (requestVersion == _requestVersion)
            {
                _listing = null;
                _error = GetSafeError(exception);
            }
        }
        finally
        {
            if (requestVersion == _requestVersion)
            {
                _rootsLoading = false;
                _loading = false;
            }
        }
    }

    private Task RefreshAsync() => LoadCurrentAsync();

    private void OpenContextMenu(FileEntryDto entry, MouseEventArgs args)
    {
        if (entry.Kind == "unsupported")
        {
            return;
        }

        _contextEntry = entry;
        _contextX = args.ClientX;
        _contextY = args.ClientY;
    }

    private void OpenCreateDialog()
    {
        _contextEntry = null;
        _dialog = DialogKind.Create;
        _newFolderName = string.Empty;
        _operationError = null;
    }

    private void OpenRenameSelected()
    {
        if (SelectedEntry is not null)
        {
            OpenRename(SelectedEntry);
        }
    }

    private void OpenRename(FileEntryDto entry)
    {
        _contextEntry = null;
        _dialog = DialogKind.Rename;
        _dialogTarget = entry;
        _newName = entry.Name;
        _operationError = null;
    }

    private void OpenDeleteSelected()
    {
        if (SelectedEntry is not null)
        {
            OpenDelete(SelectedEntry);
        }
    }

    private void OpenDelete(FileEntryDto entry)
    {
        _contextEntry = null;
        _dialog = DialogKind.Delete;
        _dialogTarget = entry;
        _deleteConfirmed = false;
        _operationError = null;
    }

    private void CloseDialog()
    {
        if (_operationInProgress)
        {
            return;
        }

        _dialog = null;
        _dialogTarget = null;
        _operationError = null;
    }

    private void OpenCopySelected() => OpenTaskDialog(FileTaskType.Copy, SelectedEntries);

    private void OpenMoveSelected() => OpenTaskDialog(FileTaskType.Move, SelectedEntries);

    private void OpenCopy(FileEntryDto entry) => OpenTaskDialog(FileTaskType.Copy, [entry]);

    private void OpenMove(FileEntryDto entry) => OpenTaskDialog(FileTaskType.Move, [entry]);

    private void OpenTaskDialog(FileTaskType type, IReadOnlyList<FileEntryDto> entries)
    {
        if (_listing is null || entries.Count == 0)
        {
            return;
        }

        _contextEntry = null;
        _taskType = type;
        _taskSources = entries.Select(entry => new FileRef(_listing.Root, entry.Path)).ToArray();
        _taskError = null;
        _taskBusy = false;
        _taskStatus = null;
    }

    private void CloseTaskDialog()
    {
        if (_taskBusy)
        {
            return;
        }

        _taskType = null;
        _taskSources = [];
        _taskError = null;
    }

    private async Task EnqueueTaskAsync(FileRef destination)
    {
        if (_taskType is null || _taskSources.Count == 0)
        {
            return;
        }

        var type = _taskType.Value;
        var sources = _taskSources;
        _taskBusy = true;
        _taskError = null;
        try
        {
            await Task.Run(async () => await Dispatcher.EnqueueAsync(type, sources, destination));
            _taskStatus = "Задача поставлена в очередь.";
            _taskType = null;
            _taskSources = [];
        }
        catch (Exception exception)
        {
            _taskError = GetSafeTaskError(exception);
        }
        finally
        {
            _taskBusy = false;
        }
    }

    private Task HandleTaskCompletedAsync(FileTask task)
    {
        _ = task;
        return LoadCurrentAsync();
    }

    private async Task CreateDirectoryAsync()
    {
        if (_listing is null)
        {
            return;
        }

        await ExecuteMutationAsync(() => Writer.CreateDirectory(new FileRef(_listing.Root, _listing.Path), _newFolderName));
    }

    private async Task RenameAsync()
    {
        if (_listing is null || _dialogTarget is null)
        {
            return;
        }

        var source = new FileRef(_listing.Root, _dialogTarget.Path);
        await ExecuteMutationAsync(() => Writer.Rename(source, _newName));
    }

    private async Task DeleteAsync()
    {
        if (_listing is null || _dialogTarget is null || !_deleteConfirmed)
        {
            return;
        }

        var source = new FileRef(_listing.Root, _dialogTarget.Path);
        await ExecuteMutationAsync(() => Writer.Delete(source));
    }

    private async Task ExecuteMutationAsync(Action mutation)
    {
        _operationInProgress = true;
        _operationError = null;
        try
        {
            await Task.Run(mutation);
            await LoadCurrentAsync();
            _operationInProgress = false;
            CloseDialog();
        }
        catch (Exception exception)
        {
            _operationError = GetSafeMutationError(exception);
        }
        finally
        {
            _operationInProgress = false;
        }
    }

    private Task NavigateToAsync(FileRef fileRef)
    {
        var query = new Dictionary<string, string?>
        {
            ["root"] = fileRef.Root,
            ["path"] = fileRef.Path
        };
        Navigation.NavigateTo(QueryHelpers.AddQueryString("/browse", query));
        return Task.CompletedTask;
    }

    private Task GoToFirstRootAsync()
    {
        var root = _roots.FirstOrDefault()?.Name;
        return root is null ? Task.CompletedTask : NavigateToAsync(new FileRef(root, string.Empty));
    }

    private IReadOnlyList<Breadcrumb> GetBreadcrumbs()
    {
        if (_listing is null || string.IsNullOrEmpty(_listing.Path))
        {
            return [];
        }

        var segments = _listing.Path.Split('/');
        var crumbs = new List<Breadcrumb>(segments.Length);
        var path = string.Empty;
        foreach (var segment in segments)
        {
            path = path.Length == 0 ? segment : $"{path}/{segment}";
            crumbs.Add(new Breadcrumb(segment, path));
        }
        return crumbs;
    }

    private void ToggleSelection(string path, bool selected)
    {
        if (selected)
        {
            _selection.Add(path);
        }
        else
        {
            _selection.Remove(path);
        }
    }

    private static string GetKindLabel(string kind) => kind switch
    {
        "directory" => "Папка",
        "file" => "Файл",
        _ => "Не поддерживается"
    };

    private static string FormatSize(long? size)
    {
        if (size is null)
        {
            return "—";
        }
        if (size < 1024)
        {
            return $"{size} Б";
        }
        var units = new[] { "КБ", "МБ", "ГБ", "ТБ" };
        var value = (double)size.Value;
        var unit = -1;
        do
        {
            value /= 1024;
            unit++;
        } while (value >= 1024 && unit < units.Length - 1);
        return $"{value:0.#} {units[unit]}";
    }

    private static string GetSafeError(Exception exception) => exception switch
    {
        RootUnavailableException => "Корень временно недоступен.",
        FileSystemObjectNotFoundException => "Корень или каталог не найден. Возможно, объект был перемещён или удалён.",
        UnsupportedFileSystemObjectException => "Этот объект файловой системы не поддерживается.",
        InvalidFileSystemRequestException => "Некорректный адрес каталога.",
        FileSystemResolutionException => "Не удалось открыть каталог.",
        _ => "Не удалось загрузить каталог. Проверьте доступ и повторите попытку."
    };

    private static string GetSafeMutationError(Exception exception) => exception switch
    {
        FileSystemNameConflictException => "Объект с таким именем уже существует.",
        FileSystemObjectNotFoundException => "Объект больше не существует. Обновите каталог.",
        RootUnavailableException => "Корень временно недоступен.",
        FileSystemAccessDeniedException => "Недостаточно прав для выполнения операции.",
        UnsupportedFileSystemObjectException => "Этот объект не поддерживается.",
        InvalidFileSystemRequestException => "Проверьте имя и выбранный объект.",
        _ => "Не удалось выполнить операцию. Повторите попытку."
    };

    private static string GetSafeTaskError(Exception exception) => exception switch
    {
        FileTaskQueueFullException => "Очередь задач заполнена. Дождитесь завершения текущих задач.",
        InvalidFileSystemRequestException => "Проверьте выбранные объекты и папку назначения.",
        FileSystemResolutionException => "Не удалось открыть выбранный объект или папку назначения.",
        ArgumentException => "Проверьте выбранные объекты и папку назначения.",
        _ => "Не удалось поставить задачу. Повторите попытку."
    };

    private sealed record Breadcrumb(string Name, string Path);

    private enum DialogKind
    {
        Create,
        Rename,
        Delete
    }
}
